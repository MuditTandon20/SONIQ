{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowForge AI",
  "version": "0.2.0",
  "identifier": "ai.flowforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowForge AI",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620
      },
      {
        "label": "indicator",
        "title": "FlowForge recording",
        "url": "index.html?indicator",
        "width": 330,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Private, offline voice dictation",
    "category": "Productivity",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
